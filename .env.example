DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/ecommerce_course
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/ecommerce_course_test
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_USERNAME=local-admin
SEED_ADMIN_PASSWORD=replace-with-a-private-admin-password
PORT=3002
APP_ORIGIN=http://localhost:3002
NODE_ENV=development

# Optional GitHub OAuth app, configured only after account/registration approval.
# Callback must exactly match the OAuth app registration. Public identity only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3002/api/auth/github/callback

# Optional Stripe sandbox only. Never use a live secret key in this course app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: /api/payments/webhook
# Without Stripe, simulated checkout is available only in development.
